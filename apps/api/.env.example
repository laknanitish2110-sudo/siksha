# Shiksha Academy Backend API Environment Variables Template
ENVIRONMENT=production
DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@[DB_HOST]:5432/postgres?sslmode=require
SECRET_KEY=[GENERATE_HIGH_ENTROPY_SECRET_KEY_HERE]
ADMIN_INITIAL_PASSWORD=[SET_SECURE_INITIAL_ADMIN_PASSWORD_HERE]
CORS_ORIGINS=https://app.shiksha.edu
